__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Data and run artefacts. Leading slashes anchor these to the repo root, so
# they do not also swallow the src/morg2smiles/data package.
/data/
/checkpoints/
/reports/
# The leaderboard is the project's experiment ledger -- every row ties metrics
# to a config hash and a git commit, which is what makes an iteration loop
# auditable after the fact. Tracked deliberately. Run logs are not.
/results/*
!/results/.gitkeep
!/results/leaderboard.jsonl
# The analysis outputs are the evidence behind docs/overnight-2026-10-09.md and
# are a few KB each. The multi-MB tqdm run logs beside them stay ignored.
!/results/overnight/
/results/overnight/*
!/results/overnight/comparison.json
!/results/overnight/scaffold_probe.json
!/results/overnight/driver.log
!/results/overnight4/
/results/overnight4/*
!/results/overnight4/rerank.json
!/results/overnight4/decode_sweep.json
!/results/overnight4/comparison_variance.json
!/results/overnight4/comparison_decode.json
!/results/overnight4/driver.log
!/results/overnight4/variance_analysis.json
!/results/overnight4/paired_tests.json
!/results/overnight4/paired_tests_consensus.json
!/results/overnight4/comparison_decode_dumped.json
!/results/overnight3/
/results/overnight3/*
!/results/overnight3/comparison_topup.json
!/results/overnight3/comparison_100k_3ep.json
!/results/overnight3/comparison_count_fp.json
!/results/overnight3/failure_analysis.json
!/results/overnight3/failures_small_1m.jsonl
!/results/overnight3/bitflip.json
!/results/overnight3/driver.log
*.pt

.DS_Store
.venv/
